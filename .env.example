# Copy to .env.local and fill in. Restart the dev server after changing it.

# Google Maps, for the map on the Services page.
# Get a key at https://developers.google.com/maps/documentation/javascript/get-api-key and enable the Maps JavaScript API.
# The key is visible to visitors, so restrict it to the site's domains (and localhost while developing).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBmgvccpJ2Ezt7UdAsfb9pLrRk_wGN8_iA

# A Map ID from Google Cloud → Map management. Leave empty to use Google's DEMO_MAP_ID while developing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
